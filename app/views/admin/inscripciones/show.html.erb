<h1>Inscripción</h1>

<dl>
  <dt>Deportista</dt>
  <dd><%= @inscripcion.deportista.nombre_completo %></dd>
  <dt>Actividad</dt>
  <dd><%= @inscripcion.actividad.nombre %></dd>
  <dt>Fecha de inscripción</dt>
  <dd><%= @inscripcion.fecha_inscripcion %></dd>
  <dt>Estado</dt>
  <dd><%= @inscripcion.estado %></dd>
</dl>

<p><%= link_to "Editar", edit_admin_inscripcion_path(@inscripcion) %></p>
<p><%= link_to "Volver a inscripciones", admin_inscripciones_path %></p>
