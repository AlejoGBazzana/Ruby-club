<div class="devise-wrapper">
  <div class="devise-card">
    <div class="devise-header">
      <div class="brand-icon">💎</div>
      <h1 class="devise-title">RUBY CLUB</h1>
      <p class="devise-subtitle">Panel de Administración</p>
    </div>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="form-group">
        <%= f.label :email, "Correo electrónico", class: "form-label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-input", placeholder: "admin@rubyclub.test", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Contraseña", class: "form-label" %>
        <%= f.password_field :password, autocomplete: "current-password", class: "form-input", required: true %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check">
          <%= f.check_box :remember_me, class: "form-checkbox" %>
          <%= f.label :remember_me, "Recordar mi sesión", class: "form-check-label" %>
        </div>
      <% end %>

      <div class="form-actions">
        <%= f.submit "Iniciar sesión", class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
