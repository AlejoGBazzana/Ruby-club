<% content_for :title, "Iniciar Sesión — Ruby Club" %>

<div class="club-container-narrow"
     data-controller="auth-guard login"
     data-auth-guard-redirect-if-logged-in-value="true">

  <div class="login-card">
    <div class="login-header">
      <div class="login-logo">💎</div>
      <h1 class="login-title">Ruby Club</h1>
      <p class="login-subtitle">Ingresá con tus credenciales de socio para acceder a tus actividades e inscripciones.</p>
    </div>

    <!-- Alerta de sesión expirada -->
    <div class="alert alert-warning"
         data-login-target="noticeContainer"
         style="display: none;">
      <span>⚠️</span>
      <span data-login-target="noticeMessage"></span>
    </div>

    <!-- Alerta de error -->
    <div class="alert alert-danger"
         data-login-target="errorContainer"
         style="display: none;">
      <span>❌</span>
      <span data-login-target="errorMessage"></span>
    </div>

    <!-- Formulario de Login -->
    <form data-action="submit->login#submit">
      <div class="form-group">
        <label for="login-email" class="form-label">Correo electrónico</label>
        <input type="email"
               id="login-email"
               class="form-input"
               placeholder="ejemplo@club.com"
               required
               autocomplete="username"
               data-login-target="email">
      </div>

      <div class="form-group">
        <label for="login-password" class="form-label">Contraseña</label>
        <input type="password"
               id="login-password"
               class="form-input"
               placeholder="••••••••"
               required
               autocomplete="current-password"
               data-login-target="password">
      </div>

      <button type="submit"
              class="btn btn-primary btn-block btn-lg"
              data-login-target="submitBtn">
        Ingresar
      </button>
    </form>
  </div>
</div>
